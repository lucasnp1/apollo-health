{
  "expo": {
    "name": "Magno",
    "slug": "magno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "magno",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0e11",
    "ios": {
      "bundleIdentifier": "app.magno.ios",
      "buildNumber": "1",
      "supportsTablet": false,
      "appleTeamId": "69Y8AJD573",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Magno",
        "NSHealthShareUsageDescription": "Magno reads your weight and blood pressure from Apple Health, for example from a smart scale or a blood pressure cuff, so they appear in your log.",
        "NSHealthUpdateUsageDescription": "Magno saves the weight and blood pressure you log to Apple Health, so your other health apps can see them."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0e11",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Magno opens the photo of a lab report you pick, to read its results on this phone.",
          "cameraPermission": "Magno uses the camera to photograph a lab report and read its results on this phone.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-notifications",
      "./plugins/withLocalNotificationsOnly"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "ios"
    ],
    "extra": {
      "billing": {
        "live": false,
        "revenuecatIosKey": "appl_zXdvrtNUtkubvbpJdbOfrifyZzE"
      }
    }
  }
}
