{
  "expo": {
    "name": "Magno",
    "slug": "magno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "magno",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0d0e11",
    "ios": {
      "bundleIdentifier": "app.magno.ios",
      "buildNumber": "9",
      "supportsTablet": false,
      "appleTeamId": "69Y8AJD573",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Magno",
        "NSHealthShareUsageDescription": "Magno reads your weight and blood pressure from Apple Health, for example from a smart scale or a blood pressure cuff, so they appear in your log.",
        "NSHealthUpdateUsageDescription": "Magno saves the weight and blood pressure you log to Apple Health, so your other health apps can see them."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      },
      "usesAppleSignIn": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0e11",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Magno opens the photo of a lab report you pick, to read its results on this phone.",
          "cameraPermission": "Magno uses the camera to photograph a lab report and read its results on this phone.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-notifications",
      "./plugins/withLocalNotificationsOnly",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.907236277182-0nqqc5tuvv1g34uh0fgs1ff4lfu87s0e"
        }
      ],
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "injection",
              "title": "Log injection",
              "icon": "symbol:syringe.fill",
              "params": {
                "href": "/log/injection"
              }
            },
            {
              "id": "bp",
              "title": "Log blood pressure",
              "icon": "symbol:heart.fill",
              "params": {
                "href": "/log/bp"
              }
            },
            {
              "id": "weight",
              "title": "Log weight",
              "icon": "symbol:scalemass.fill",
              "params": {
                "href": "/log/weight"
              }
            },
            {
              "id": "checkin",
              "title": "Check in",
              "icon": "symbol:brain.head.profile",
              "params": {
                "href": "/log/checkin"
              }
            }
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.app.magno.ios",
          "widgets": [
            {
              "name": "NextShot",
              "displayName": "Next shot",
              "description": "When your last injection was and when the next reminder is due.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "ios"
    ],
    "extra": {
      "billing": {
        "live": true,
        "revenuecatIosKey": "appl_zXdvrtNUtkubvbpJdbOfrifyZzE"
      },
      "googleIosClientId": "907236277182-0nqqc5tuvv1g34uh0fgs1ff4lfu87s0e.apps.googleusercontent.com"
    }
  }
}
